{
  "name": "maplecord",
  "productName": "Maplecord",
  "private": true,
  "license": "GPL-3.0-or-later",
  "author": "Kenny Lasyone",
  "version": "0.3.5",
  "description": "Loot rolling, chat and voice for your party",
  "repository": "github:kl3mta3/Maplecord",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "version:sync": "node scripts/version.mjs",
    "dev": "node scripts/version.mjs && vite",
    "dev:web": "node scripts/version.mjs && vite --mode web",
    "build": "node scripts/version.mjs && tsc -b && vite build",
    "build:web": "node scripts/version.mjs && tsc -b && vite build --mode web",
    "build:server-web": "node scripts/version.mjs && tsc -b && vite build --mode web --outDir ../Maplecord/src/Maplecord.Server/webapp --emptyOutDir",
    "dist": "node scripts/need-server.mjs && npm run build && electron-builder",
    "dist:win": "node scripts/need-server.mjs && npm run build && electron-builder --win",
    "dist:mac": "node scripts/need-server.mjs && npm run build && electron-builder --mac",
    "dist:linux": "node scripts/need-server.mjs && npm run build && electron-builder --linux",
    "lint": "oxlint .",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "test": "node electron/plugins.test.ts && node electron/soundPacks.test.ts && node electron/fileCache.test.ts && node electron/saveStreams.test.ts && node electron/offeredFiles.test.ts && node electron/updateRules.test.ts && node src/invites.test.ts && node src/streamLimit.test.ts && node src/effectRules.test.ts && node src/channelViewers.test.ts && node src/p2pPosts.test.ts && node src/leafQr.test.ts",
    "sounds": "node tools/make-sounds.mjs"
  },
  "dependencies": {
    "@fontsource/bangers": "^5.3.0",
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/creepster": "^5.3.0",
    "@fontsource/fredoka": "^5.3.0",
    "@fontsource/orbitron": "^5.3.0",
    "@fontsource/pacifico": "^5.3.0",
    "@fontsource/permanent-marker": "^5.3.0",
    "@fontsource/press-start-2p": "^5.3.0",
    "@fontsource/unifrakturcook": "^5.3.0",
    "@fontsource/vt323": "^5.3.0",
    "@microsoft/signalr": "^10.0.11",
    "lottie-web": "^5.13.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "uiohook-napi": "^1.5.5"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "livekit-client": "^2.22.3",
    "lucide-react": "^1.52.0",
    "oxlint": "^1.87.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.2",
    "vite-plugin-electron": "^1.1.2",
    "vite-plugin-electron-renderer": "^1.0.0"
  },
  "build": {
    "appId": "app.maplecord.desktop",
    "productName": "Maplecord",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-electron/**"
    ],
    "npmRebuild": false,
    "asarUnpack": [
      "node_modules/uiohook-napi/**"
    ],
    "icon": "build/icon.png",
    "protocols": [
      {
        "name": "Maplecord invite",
        "schemes": [
          "maplecord"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "artifactName": "Maplecord-Portable-${version}.${ext}"
    },
    "nsis": {
      "artifactName": "Maplecord-Setup-${version}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.social-networking"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Network"
    }
  }
}
