{
  "name": "maplecord",
  "productName": "Maplecord",
  "private": true,
  "version": "0.1.0",
  "description": "Loot rolling, chat and voice for your party",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "dev:web": "vite --mode web",
    "build": "tsc -b && vite build",
    "build:web": "tsc -b && vite build --mode web",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux",
    "lint": "oxlint .",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "test": "node electron/plugins.test.ts && node electron/soundPacks.test.ts",
    "sounds": "node tools/make-sounds.mjs"
  },
  "dependencies": {
    "@fontsource/bangers": "^5.3.0",
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/creepster": "^5.3.0",
    "@fontsource/fredoka": "^5.3.0",
    "@fontsource/orbitron": "^5.3.0",
    "@fontsource/pacifico": "^5.3.0",
    "@fontsource/permanent-marker": "^5.3.0",
    "@fontsource/press-start-2p": "^5.3.0",
    "@fontsource/unifrakturcook": "^5.3.0",
    "@fontsource/vt323": "^5.3.0",
    "@microsoft/signalr": "^10.0.11",
    "lottie-web": "^5.13.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.87.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.2",
    "vite-plugin-electron": "^1.1.2",
    "vite-plugin-electron-renderer": "^1.0.0"
  },
  "build": {
    "appId": "app.maplecord.desktop",
    "productName": "Maplecord",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-electron/**"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.social-networking"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Network"
    }
  }
}
